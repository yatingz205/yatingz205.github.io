{%- comment -%}
  LOCAL ADDITION: make the theme control a plain two-state toggle.

  al_folio_core's assets/js/theme.js cycles system -> light -> dark -> system, so
  from the default "system" setting the first click is a visual no-op for anyone
  whose OS already matches -- it looks like the icon needs two clicks to work.

  theme.js binds the button as `function () { toggleThemeSetting(); }`, i.e. it
  looks the function up at click time rather than capturing it, and declares it
  with a top-level `let`. So reassigning the binding here (no `let` -- redeclaring
  would be a SyntaxError) is enough, and avoids copying all 337 lines of theme.js,
  most of which is Plotly theme data that would drift on every gem upgrade.

  This script must run after theme.js, which is loaded in <head>; this include is
  rendered at the top of <body>, so it does.

  Behaviour: until the first click the site still follows the OS (setting stays
  "system"); each click then flips whichever theme is currently showing.
{%- endcomment -%}
<script>
  if (typeof toggleThemeSetting === 'function') {
    toggleThemeSetting = () => {
      setThemeSetting(determineComputedTheme() === 'dark' ? 'light' : 'dark');
    };
  }
</script>

<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != '/' %}
        <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% social_links %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- comment -%}
                    LOCAL ADDITION: a page may point its navbar entry somewhere other than its
                    own URL with `nav_href:` in front matter, and open it in a new tab with
                    `nav_new_tab: true`. Used by _pages/cv.md to send the "cv" tab straight to
                    the PDF. jekyll-link-attributes cannot do this: it only adds target="_blank"
                    to off-domain URLs, and the PDF is on this domain.
                  {%- endcomment -%}
                  {%- if p.nav_href -%}
                    {%- assign url = p.nav_href -%}
                  {%- elsif p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a
                    class="nav-link"
                    href="{{ url | relative_url }}"
                    {% if p.nav_new_tab %}
                      target="_blank" rel="noopener"
                    {% endif %}
                  >
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" type="button" title="Search" aria-label="Open search">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                {%- comment -%}
                  LOCAL: inline SVG instead of a Font Awesome class. The wanted look is
                  FA's "sun-bright" (filled disc + eight straight rays), which is Pro-only,
                  so this is equivalent geometry drawn from scratch -- no Pro artwork, no
                  licence issue. Rays are filled rects rather than strokes so the shape is
                  independent of stroke scaling. `fill="currentColor"` makes it inherit
                  #light-toggle's colour and :hover exactly like the <i> icons do.
                {%- endcomment -%}
                <svg id="light-toggle-light" class="af-sun-bright" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                  <circle cx="12" cy="12" r="4.8" />
                  <rect x="10.9" y="0.2" width="2.2" height="4.9" rx="1.1" transform="rotate(0 12 12)" />
                  <rect x="10.9" y="0.2" width="2.2" height="4.9" rx="1.1" transform="rotate(45 12 12)" />
                  <rect x="10.9" y="0.2" width="2.2" height="4.9" rx="1.1" transform="rotate(90 12 12)" />
                  <rect x="10.9" y="0.2" width="2.2" height="4.9" rx="1.1" transform="rotate(135 12 12)" />
                  <rect x="10.9" y="0.2" width="2.2" height="4.9" rx="1.1" transform="rotate(180 12 12)" />
                  <rect x="10.9" y="0.2" width="2.2" height="4.9" rx="1.1" transform="rotate(225 12 12)" />
                  <rect x="10.9" y="0.2" width="2.2" height="4.9" rx="1.1" transform="rotate(270 12 12)" />
                  <rect x="10.9" y="0.2" width="2.2" height="4.9" rx="1.1" transform="rotate(315 12 12)" />
                </svg>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
